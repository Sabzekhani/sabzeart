# Public base URL that the QR codes point to
NEXT_PUBLIC_SITE_URL=https://sabze.nl

# Password for the /studio page (translate + publish)
STUDIO_PASSWORD=choose-a-long-password

# Claude API key used to draft Dutch translations
ANTHROPIC_API_KEY=

# Optional: lets "Publish" commit data/poems.json to GitHub (Vercel then redeploys)
# Fine-grained token with "Contents: read & write" on this repository only
GITHUB_TOKEN=
GITHUB_REPO=sabzekhani/sabzeart
GITHUB_BRANCH=main
