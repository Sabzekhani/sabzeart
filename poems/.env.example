# Public address of this site (your own domain). QR codes point to <this>/p/<slug>.
# Example: https://poezie.example.nl
NEXT_PUBLIC_SITE_URL=

# Site name shown in the header
NEXT_PUBLIC_SITE_NAME=Perzische Poëzie

# Password for the /studio page (translate + publish)
STUDIO_PASSWORD=choose-a-long-password

# Claude API key used to draft Dutch translations
ANTHROPIC_API_KEY=

# Optional: lets "Publish" commit the poems file to GitHub (Vercel then redeploys)
# Fine-grained token with "Contents: read & write" on this repository only
GITHUB_TOKEN=
GITHUB_REPO=sabzekhani/sabzeart
GITHUB_BRANCH=main
GITHUB_FILE_PATH=poems/data/poems.json
